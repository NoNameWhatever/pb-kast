#!/usr/bin/env python3
"""Klient mot GitHub-brokern på hosten (D6:9). Mallägd, körs i dev-imagen.

  pb-broker-client token              skriver en installationstoken på stdout
  pb-broker-client credential <op>    git credential helper (bara `get` för https://github.com)

Anslutningen till brokerns socket tar inget indata: brokern skriver en token för projektets repo och
stänger. Ingen GitHub-credential sparas någonstans. Saknas brokern får agenten ett fel och stannar."""
import os
import re
import socket
import sys

SOCKET = os.environ.get("PB_BROKER_SOCKET", "/run/pb-broker/sock")
TIMEOUT = 5.0
# Samma regel som brokerns (host/pbhost/broker.py): `ghs_` och tecken ur [A-Za-z0-9._-], 36 till 2000 tecken. GitHubs nya `ghs_APPID_JWT` är ca 520 tecken
# med två punkter. Läsgränsen nedan ligger över taket, så en för lång post läses så långt att regexen avvisar den i stället för att kortas till något som ser ut som en token.
MAX_TOKEN = 2000
TOKEN_RE = re.compile(r"^ghs_[A-Za-z0-9._-]{36,%d}$" % MAX_TOKEN)


class BrokerError(Exception):
    pass


def fetch(path=SOCKET, timeout=TIMEOUT):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
        data = b""
        while len(data) <= MAX_TOKEN + 8:
            chunk = s.recv(512)
            if not chunk:
                break
            data += chunk
    except (OSError, socket.timeout) as e:
        raise BrokerError("cannot reach the broker at %s: %s" % (path, e))
    finally:
        s.close()
    token = data.decode("ascii", "replace").strip()
    if not TOKEN_RE.match(token):
        raise BrokerError("the broker returned something that is not a token")
    return token


def credential(op, stdin):
    if op != "get":
        return 0
    attrs = dict(line.split("=", 1) for line in stdin.read().splitlines() if "=" in line)
    if attrs.get("protocol") != "https" or attrs.get("host") != "github.com":
        return 0
    print("username=x-access-token")
    print("password=%s" % fetch())
    return 0


def main(argv):
    try:
        if argv[:1] == ["token"]:
            print(fetch())
            return 0
        if argv[:1] == ["credential"]:
            return credential(argv[1] if len(argv) > 1 else "", sys.stdin)
    except BrokerError as e:
        print("pb-broker-client: %s" % e, file=sys.stderr)
        return 1
    print("usage: pb-broker-client token | credential <op>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
