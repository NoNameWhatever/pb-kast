#!/usr/bin/env python3
"""pb-baseline <create|prune>: skapar och krymper baslinjen av befintliga lint- och typfel (D8:5, D8:25, D7:19).

`create` körs vid adoptionen, före adoptionens commit, och skriver `project-docs/baseline/<modul>.jsonl`. `prune` tar bort
poster som inte längre har något fynd. En baslinje kan aldrig växa i en PR (`pb-check baseline`).
Exitkoder: 0 klart, 1 användningsfel, 2 kunde inte köras."""
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from pbcore import baseline  # noqa: E402
from pbcore.common import CannotRun, repo_root  # noqa: E402
from pbcore.units import load_units  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="pb-baseline")
    ap.add_argument("action", choices=("create", "prune"))
    ap.add_argument("--force", action="store_true", help="skriv över en befintlig baslinje (create)")
    ap.add_argument("--root")
    a = ap.parse_args(argv)
    try:
        root = repo_root(a.root or ".")
        units = [(u["module"], u["path"]) for u in load_units(root)]
        if not units:
            print("no code units in .claude/units.yml; nothing to baseline")
            return 0
        if a.action == "create":
            written = baseline.create(root, units, force=a.force)
            for path, n in written:
                print("wrote %s (%d entries)" % (path, n))
            if not written:
                print("no baselinable errors; no baseline needed")
        else:
            for path, removed in baseline.prune(root, units):
                print("%s: removed %d stale entr%s" % (path, removed, "y" if removed == 1 else "ies"))
        return 0
    except CannotRun as e:
        print("cannot run pb-baseline: %s" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main())
