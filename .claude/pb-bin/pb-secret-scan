#!/usr/bin/env python3
"""pb-secret-scan: gitleaks över commits från merge-basen till HEAD (D6:26).
Exitkoder: 0 inget fynd, 1 fynd, 2 kunde inte köras."""
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from pbcore import secretscan  # noqa: E402
from pbcore.common import EXIT_UNKNOWN, CannotRun, repo_root  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="pb-secret-scan")
    ap.add_argument("--root")
    a = ap.parse_args(argv)
    try:
        root = repo_root(a.root or ".")
        return secretscan.scan(root).emit(root)
    except CannotRun as e:
        print("cannot run secret-scan: %s" % e)
        return EXIT_UNKNOWN


if __name__ == "__main__":
    sys.exit(main())
