#!/usr/bin/env python3
"""pb-stats [--json] [--ref REF] [--no-gh]: mätetal ur git, issue-filer, felregistret och `gh` (D11:8, D11:9).
Läsande, lagrar ingenting, körs på begäran eller vid hygienkörningen. Exitkoder: 0 klart, 2 kunde inte köras."""
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from pbcore import stats  # noqa: E402
from pbcore.common import CannotRun, repo_root  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="pb-stats")
    ap.add_argument("--json", action="store_true", help="versionerat JSON-schema i stället för text")
    ap.add_argument("--ref", help="räkna om vid en äldre commit eller gren (standard: main)")
    ap.add_argument("--no-gh", action="store_true", help="hoppa över mätetal som kräver GitHub")
    ap.add_argument("--root")
    a = ap.parse_args(argv)
    try:
        root = repo_root(a.root or ".")
        stats.emit(stats.compute(root, ref=a.ref, use_gh=not a.no_gh), as_json=a.json)
        return 0
    except CannotRun as e:
        print("cannot run pb-stats: %s" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main())
