#!/usr/bin/env python3
"""pb-start: läsande orientering vid sessionsstart (D4:17). Ändrar aldrig arbetsträdet.
Exitkoder: 0 inget att rapportera utöver INFO, 1 STOPP, 2 något kunde inte kontrolleras."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from pbcore import start  # noqa: E402
from pbcore.common import EXIT_UNKNOWN, CannotRun, repo_root  # noqa: E402


def main():
    try:
        root = repo_root(".")
        lines, stopped, unknown = start.orient(root, cwd=os.getcwd())
    except CannotRun as e:
        print("OKÄNT: pb-start could not run: %s" % e)
        return EXIT_UNKNOWN
    print("\n".join(lines) if lines else "ok start")
    return 1 if stopped else EXIT_UNKNOWN if unknown else 0


if __name__ == "__main__":
    sys.exit(main())
